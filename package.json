{
  "name": "mocap-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Video → BVH motion capture workspace. Pure-TypeScript mocap core + a Notion-style web frontend.",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "dev": "pnpm --filter @mocap-ts/web dev",
    "platform": "bash scripts/platform.sh",
    "platform:dev:start": "bash scripts/platform.sh dev start",
    "platform:dev:stop": "bash scripts/platform.sh dev stop",
    "platform:dev:restart": "bash scripts/platform.sh dev restart",
    "platform:dev:status": "bash scripts/platform.sh dev status",
    "platform:dev:logs": "bash scripts/platform.sh dev logs",
    "platform:prod:start": "bash scripts/platform.sh prod start",
    "platform:prod:stop": "bash scripts/platform.sh prod stop",
    "platform:prod:restart": "bash scripts/platform.sh prod restart",
    "platform:prod:status": "bash scripts/platform.sh prod status",
    "platform:prod:logs": "bash scripts/platform.sh prod logs",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tensorflow/tfjs-node",
      "esbuild"
    ]
  }
}
