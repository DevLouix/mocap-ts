{
  "name": "mocap-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Video → BVH motion capture workspace. Pure-TypeScript mocap core + a Notion-style web frontend.",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "dev": "pnpm --filter @mocap-ts/web dev",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tensorflow/tfjs-node",
      "esbuild"
    ]
  }
}
